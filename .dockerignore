# ==============================================
# Docker Build Ignore File
# ==============================================

# Environment files - CRITICAL: These must not be included in Docker images
# as they contain local/development values that override production config
**/.env
**/.env.*
**/.env.local
**/.env.development
**/.env.production
.env
.env.*

# Git
.git
.gitignore
.github

# Documentation
docs
*.md
README.md
CHANGELOG.md

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~

# Test files and coverage
**/coverage
**/__tests__
**/*.spec.ts
**/*.test.ts
**/jest.config.js
**/playwright.config.ts
e2e

# Build artifacts (we build inside Docker)
**/dist
**/build
**/.next

# Dependencies (we install inside Docker)
**/node_modules

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local development files
docker-compose.yml
docker-compose*.yml
local-dev
scripts
terraform
keycloak

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db
