# ==============================================================================
# PlainLedger - Production Terraform Variables
# Copy this file to terraform.tfvars and fill in values
# ==============================================================================

# GitHub (required)
github_org = "stonyp90"

# Stripe API Keys (required for payment processing)
stripe_secret_key      = "sk_live_..."
stripe_publishable_key = "pk_live_..."

# Novu API Keys (required for notifications)
novu_api_key = "..."
novu_app_id  = "..."

# Keycloak Client Secret (REQUIRED for authentication)
# Get this from Keycloak Admin Console:
# 1. Log into https://auth.plainledger.ca
# 2. Go to: Realm 'plainledger' → Clients → 'plainledger-api'
# 3. Go to 'Credentials' tab
# 4. Copy the 'Secret' value
keycloak_client_secret = "your-keycloak-client-secret-here"

# Slack Alerts (incoming webhook for #plainledger-alerts)
slack_alert_webhook_url = "https://hooks.slack.com/services/..."

# Optional overrides
# domain_name          = "plainledger.ca"
# create_hosted_zone   = true
# db_instance_class    = "db.t3.medium"
# redis_node_type      = "cache.t3.micro"
