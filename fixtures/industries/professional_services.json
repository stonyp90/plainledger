  "kpis": [
    {
      "id": "utilization_rate",
      "name": "Utilization Rate",
      "name_fr": "Taux d'utilisation",
      "formula": "(billable_hours / available_hours) * 100",
      "benchmark_min": 70,
      "benchmark_max": 85,
      "format": "percent",
      "inverse": false
    },
    {
      "id": "realization_rate",
      "name": "Realization Rate",
      "name_fr": "Taux de réalisation",
      "formula": "(billed_revenue / billable_value) * 100",
      "benchmark_min": 85,
      "benchmark_max": 95,
      "format": "percent",
      "inverse": false
    },
    {
      "id": "ar_days",
      "name": "AR Days",
      "name_fr": "Jours comptes clients",
      "formula": "(ar / billable_revenue) * 365",
      "benchmark_min": 30,
      "benchmark_max": 60,
      "format": "days",
      "inverse": true
    },
    {
      "id": "revenue_per_employee",
      "name": "Revenue per Employee",
      "name_fr": "Revenu par employé",
      "formula": "total_revenue / employee_count",
      "benchmark_min": 150000,
      "benchmark_max": 300000,
      "format": "currency",
      "inverse": false
    },
    {
      "id": "profit_margin",
      "name": "Net Profit Margin",
      "name_fr": "Marge bénéficiaire nette",
      "formula": "(net_income / total_revenue) * 100",
      "benchmark_min": 15,
      "benchmark_max": 25,
      "format": "percent",
      "inverse": false
    }
  ],
  
  "transactions": {
    "revenue_range": [150000, 400000],
    "expense_ratio": 0.50,
