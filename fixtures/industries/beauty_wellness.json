  "kpis": [
    {
      "id": "revenue_per_client",
      "name": "Revenue per Client",
      "name_fr": "Revenu par client",
      "formula": "total_revenue / client_count",
      "benchmark_min": 80,
      "benchmark_max": 200,
      "format": "currency",
      "inverse": false
    },
    {
      "id": "client_retention",
      "name": "Client Retention %",
      "name_fr": "Rétention clients %",
      "formula": "(returning_clients / total_clients) * 100",
      "benchmark_min": 65,
      "benchmark_max": 85,
      "format": "percent",
      "inverse": false
    },
    {
      "id": "service_utilization",
      "name": "Service Utilization %",
      "name_fr": "Utilisation services %",
      "formula": "(booked_hours / available_hours) * 100",
      "benchmark_min": 75,
      "benchmark_max": 90,
      "format": "percent",
      "inverse": false
    },
    {
      "id": "product_sales_ratio",
      "name": "Product Sales Ratio",
      "name_fr": "Ratio ventes produits",
      "formula": "(product_sales / service_revenue) * 100",
      "benchmark_min": 15,
      "benchmark_max": 30,
      "format": "percent",
      "inverse": false
    },
    {
      "id": "net_margin",
      "name": "Net Margin %",
      "name_fr": "Marge nette %",
      "formula": "(net_income / total_revenue) * 100",
      "benchmark_min": 15,
      "benchmark_max": 25,
      "format": "percent",
      "inverse": false
    }
  ],
  
  "transactions": {
    "revenue_range": [80000, 200000],
    "expense_ratio": 0.55,
    "months_of_data": 6
  },
  
