  "kpis": [
    {
      "id": "revenue_per_mile",
      "name": "Revenue per Mile",
      "name_fr": "Revenu par mille",
      "formula": "total_revenue / total_miles",
      "benchmark_min": 2.50,
      "benchmark_max": 4.00,
      "format": "currency",
      "inverse": false
    },
    {
      "id": "fuel_efficiency",
      "name": "Fuel Efficiency (MPG)",
      "name_fr": "Efficacité carburant (MPG)",
      "formula": "total_miles / gallons_consumed",
      "benchmark_min": 6.5,
      "benchmark_max": 8.5,
      "format": "number",
      "inverse": false
    },
    {
      "id": "utilization_rate",
      "name": "Fleet Utilization %",
      "name_fr": "Utilisation flotte %",
      "formula": "(loaded_miles / total_miles) * 100",
      "benchmark_min": 75,
      "benchmark_max": 90,
      "format": "percent",
      "inverse": false
    },
    {
      "id": "on_time_delivery",
      "name": "On-Time Delivery %",
      "name_fr": "Livraison à temps %",
      "formula": "(on_time_deliveries / total_deliveries) * 100",
      "benchmark_min": 95,
      "benchmark_max": 99,
      "format": "percent",
      "inverse": false
    },
    {
      "id": "cost_per_mile",
      "name": "Cost per Mile",
      "name_fr": "Coût par mille",
      "formula": "total_costs / total_miles",
      "benchmark_min": 1.50,
      "benchmark_max": 2.50,
      "format": "currency",
      "inverse": true
    }
  ],
  
  "transactions": {
    "revenue_range": [250000, 700000],
    "expense_ratio": 0.78,
    "months_of_data": 6
