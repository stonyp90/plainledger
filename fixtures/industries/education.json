  "kpis": [
    {
      "id": "student_retention",
      "name": "Student Retention %",
      "name_fr": "Rétention étudiants %",
      "formula": "(continuing_students / total_students) * 100",
      "benchmark_min": 85,
      "benchmark_max": 95,
      "format": "percent",
      "inverse": false
    },
    {
      "id": "revenue_per_student",
      "name": "Revenue per Student",
      "name_fr": "Revenu par étudiant",
      "formula": "total_revenue / student_count",
      "benchmark_min": 3000,
      "benchmark_max": 15000,
      "format": "currency",
      "inverse": false
    },
    {
      "id": "class_utilization",
      "name": "Class Utilization %",
      "name_fr": "Utilisation des classes %",
      "formula": "(students_enrolled / class_capacity) * 100",
      "benchmark_min": 80,
      "benchmark_max": 95,
      "format": "percent",
      "inverse": false
    },
    {
      "id": "instructor_cost_ratio",
      "name": "Instructor Cost Ratio",
      "name_fr": "Ratio coût instructeurs",
      "formula": "(instructor_salaries / total_revenue) * 100",
      "benchmark_min": 30,
      "benchmark_max": 50,
      "format": "percent",
      "inverse": true
    },
    {
      "id": "net_margin",
      "name": "Net Margin %",
      "name_fr": "Marge nette %",
      "formula": "(net_income / total_revenue) * 100",
      "benchmark_min": 8,
      "benchmark_max": 15,
      "format": "percent",
      "inverse": false
    }
  ],
  
  "transactions": {
    "revenue_range": [150000, 400000],
    "expense_ratio": 0.58,
    "months_of_data": 6
  },
  
  "expected_gold": {
