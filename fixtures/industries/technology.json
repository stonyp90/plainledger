  "kpis": [
    {
      "id": "gross_margin_pct",
      "name": "Gross Margin %",
      "name_fr": "Marge brute %",
      "formula": "((recurring_revenue - hosting_infrastructure) / recurring_revenue) * 100",
      "benchmark_min": 60,
      "benchmark_max": 80,
      "format": "percent",
      "inverse": false
    },
    {
      "id": "cac_payback",
      "name": "CAC Payback (months)",
      "name_fr": "Récupération CAC (mois)",
      "formula": "sales_marketing / (recurring_revenue / 12)",
      "benchmark_min": 6,
      "benchmark_max": 18,
      "format": "number",
      "inverse": true
    },
    {
      "id": "ltv_cac_ratio",
      "name": "LTV:CAC Ratio",
      "name_fr": "Ratio LTV:CAC",
      "formula": "customer_ltv / cac",
      "benchmark_min": 3,
      "benchmark_max": 5,
      "format": "ratio",
      "inverse": false
    },
    {
      "id": "arr_growth",
      "name": "ARR Growth %",
      "name_fr": "Croissance ARR %",
      "formula": "((current_arr - prior_arr) / prior_arr) * 100",
      "benchmark_min": 20,
      "benchmark_max": 100,
      "format": "percent",
      "inverse": false
    },
    {
      "id": "net_revenue_retention",
      "name": "Net Revenue Retention %",
      "name_fr": "Rétention nette %",
      "formula": "((starting_arr + expansion - contraction - churn) / starting_arr) * 100",
      "benchmark_min": 100,
      "benchmark_max": 130,
      "format": "percent",
      "inverse": false
    }
  ],
  
  "transactions": {
    "revenue_range": [200000, 600000],
    "expense_ratio": 0.35,
    "months_of_data": 6,
    "revenue_distribution": {
      "recurring_revenue": 0.75,
      "license_revenue": 0.10,
      "services_revenue": 0.10,
      "support_revenue": 0.05
    },
    "expense_distribution": {
