  "kpis": [
    {
      "id": "gross_margin_pct",
      "name": "Gross Margin %",
      "name_fr": "Marge brute %",
      "formula": "((project_revenue - direct_costs) / project_revenue) * 100",
      "benchmark_min": 15,
      "benchmark_max": 30,
      "format": "percent",
      "inverse": false
    },
    {
      "id": "backlog_months",
      "name": "Backlog Months",
      "name_fr": "Carnet de commandes (mois)",
      "formula": "backlog_value / (project_revenue / 12)",
      "benchmark_min": 3,
      "benchmark_max": 12,
      "format": "number",
      "inverse": false
    },
    {
      "id": "wip_balance",
      "name": "WIP Balance",
      "name_fr": "Travaux en cours",
      "formula": "wip",
      "benchmark_min": 0,
      "benchmark_max": 500000,
      "format": "currency",
      "inverse": false
    },
    {
      "id": "bid_win_rate",
      "name": "Bid Win Rate",
      "name_fr": "Taux de succès des soumissions",
      "formula": "(won_bids / total_bids) * 100",
      "benchmark_min": 15,
      "benchmark_max": 30,
      "format": "percent",
      "inverse": false
    },
    {
      "id": "days_to_bill",
      "name": "Days to Bill",
      "name_fr": "Jours avant facturation",
      "formula": "avg_days_work_to_invoice",
      "benchmark_min": 15,
      "benchmark_max": 45,
      "format": "days",
      "inverse": true
    }
  ],
  
  "transactions": {
    "revenue_range": [300000, 800000],
    "expense_ratio": 0.75,
    "months_of_data": 6,
    "revenue_distribution": {
      "project_revenue": 0.95,
      "retainage": 0.05
    },
