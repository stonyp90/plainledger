  "kpis": [
    {
      "id": "food_cost_pct",
      "name": "Food Cost %",
      "name_fr": "Coût nourriture %",
      "formula": "(food_cost / food_sales) * 100",
      "benchmark_min": 28,
      "benchmark_max": 35,
      "format": "percent",
      "inverse": true
    },
    {
      "id": "beverage_cost_pct",
      "name": "Beverage Cost %",
      "name_fr": "Coût boissons %",
      "formula": "(beverage_cost / beverage_sales) * 100",
      "benchmark_min": 18,
      "benchmark_max": 24,
      "format": "percent",
      "inverse": true
    },
    {
      "id": "labor_cost_pct",
      "name": "Labor Cost %",
      "name_fr": "Coût main-d'œuvre %",
      "formula": "(labor_cost / total_revenue) * 100",
      "benchmark_min": 25,
      "benchmark_max": 35,
      "format": "percent",
      "inverse": true
    },
    {
      "id": "prime_cost_pct",
      "name": "Prime Cost %",
      "name_fr": "Coût primaire %",
      "formula": "((food_cost + beverage_cost + labor_cost) / total_revenue) * 100",
      "benchmark_min": 55,
      "benchmark_max": 65,
      "format": "percent",
      "inverse": true
    },
    {
      "id": "occupancy_cost_pct",
      "name": "Occupancy Cost %",
      "name_fr": "Coût occupation %",
      "formula": "(occupancy / total_revenue) * 100",
      "benchmark_min": 6,
      "benchmark_max": 10,
      "format": "percent",
      "inverse": true
    }
  ],
  
