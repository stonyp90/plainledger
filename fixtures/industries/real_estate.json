  "kpis": [
    {
      "id": "noi",
      "name": "Net Operating Income",
      "name_fr": "Revenu net d'exploitation",
      "formula": "rental_income - operating_expenses",
      "benchmark_min": 50000,
      "benchmark_max": 200000,
      "format": "currency",
      "inverse": false
    },
    {
      "id": "cap_rate",
      "name": "Cap Rate",
      "name_fr": "Taux de capitalisation",
      "formula": "((rental_income - operating_expenses) / property_value) * 100",
      "benchmark_min": 4,
      "benchmark_max": 10,
      "format": "percent",
      "inverse": false
    },
    {
      "id": "expense_ratio",
      "name": "Operating Expense Ratio",
      "name_fr": "Ratio des dépenses",
      "formula": "(operating_expenses / rental_income) * 100",
      "benchmark_min": 30,
      "benchmark_max": 50,
      "format": "percent",
      "inverse": true
    },
    {
      "id": "cash_on_cash",
      "name": "Cash-on-Cash Return",
      "name_fr": "Rendement cash-on-cash",
      "formula": "((rental_income - operating_expenses - financing_cost) / equity) * 100",
      "benchmark_min": 8,
      "benchmark_max": 12,
      "format": "percent",
      "inverse": false
    },
    {
      "id": "debt_service_coverage",
      "name": "Debt Service Coverage Ratio",
      "name_fr": "Ratio de couverture de la dette",
      "formula": "(rental_income - operating_expenses) / financing_cost",
      "benchmark_min": 1.2,
      "benchmark_max": 1.5,
      "format": "ratio",
      "inverse": false
    }
  ],
  
  "transactions": {
    "revenue_range": [150000, 350000],
    "expense_ratio": 0.45,
    "months_of_data": 6,
    "revenue_distribution": {
      "rental_income": 0.92,
      "management_fees": 0.05,
      "other_income": 0.03
    },
    "expense_distribution": {
      "operating_expenses": 0.60,
      "labor_cost": 0.15,
      "financing_cost": 0.25
    }
  },
  
  "expected_gold": {
