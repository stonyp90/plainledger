  "kpis": [
    {
      "id": "yield_per_hectare",
      "name": "Yield per Hectare",
      "name_fr": "Rendement par hectare",
      "formula": "total_production / hectares_farmed",
      "benchmark_min": 5000,
      "benchmark_max": 12000,
      "format": "number",
      "inverse": false
    },
    {
      "id": "cost_per_unit",
      "name": "Cost per Unit",
      "name_fr": "Coût par unité",
      "formula": "total_costs / total_production",
      "benchmark_min": 0.10,
      "benchmark_max": 0.50,
      "format": "currency",
      "inverse": true
    },
    {
      "id": "profit_margin",
      "name": "Profit Margin %",
      "name_fr": "Marge bénéficiaire %",
      "formula": "(net_income / total_revenue) * 100",
      "benchmark_min": 15,
      "benchmark_max": 25,
      "format": "percent",
      "inverse": false
    },
    {
      "id": "input_cost_ratio",
      "name": "Input Cost Ratio",
      "name_fr": "Ratio coûts intrants",
      "formula": "((seeds + fertilizer + feed) / total_revenue) * 100",
      "benchmark_min": 30,
      "benchmark_max": 45,
      "format": "percent",
      "inverse": true
    },
    {
      "id": "subsidy_dependency",
      "name": "Subsidy Dependency %",
      "name_fr": "Dépendance subventions %",
      "formula": "(subsidies / total_revenue) * 100",
      "benchmark_min": 5,
      "benchmark_max": 20,
      "format": "percent",
      "inverse": true
    }
  ],
  
  "transactions": {
    "revenue_range": [200000, 600000],
