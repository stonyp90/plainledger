# ==============================================================================
# PlainLedger - Environment Configuration
# Copy this file to .env and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plainledger
DB_USERNAME=plainledger
DB_PASSWORD=your_secure_password

# ------------------------------------------------------------------------------
# Keycloak Authentication
# ------------------------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=plainledger
KEYCLOAK_CLIENT_ID=plainledger-api
KEYCLOAK_CLIENT_SECRET=your_keycloak_secret

# ------------------------------------------------------------------------------
# Redis Cache
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# S3 / Datalake Configuration
# ------------------------------------------------------------------------------
# For LocalStack (local development)
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# For AWS (production)
# S3_ENDPOINT=https://s3.ca-central-1.amazonaws.com
# S3_REGION=ca-central-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Medallion Architecture Buckets
S3_BUCKET_BRONZE=plainledger-bronze
S3_BUCKET_SILVER=plainledger-silver
S3_BUCKET_GOLD=plainledger-gold

# ------------------------------------------------------------------------------
# QuickBooks Integration
# Get credentials from: https://developer.intuit.com/app/developer/dashboard
# ------------------------------------------------------------------------------
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/v1/datasources/oauth/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox

# ------------------------------------------------------------------------------
# Power BI / Azure AD Integration
# Get credentials from: https://portal.azure.com
# ------------------------------------------------------------------------------
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
POWERBI_WORKSPACE_ID=your_workspace_id

# ------------------------------------------------------------------------------
# Stripe Payments
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ------------------------------------------------------------------------------
# Novu Notifications
# ------------------------------------------------------------------------------
NOVU_API_KEY=your_novu_api_key
NOVU_APP_ID=your_novu_app_id

# ------------------------------------------------------------------------------
# AI Services (Optional)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
