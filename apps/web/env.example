# =============================================================================
# PlainLedger Web Application - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# 
# NOTE: All VITE_ prefixed variables are exposed to the browser.
# NEVER put secrets here - only public configuration!
# 
# REQUIRED FOR PRODUCTION:
# - VITE_API_URL
# - VITE_KEYCLOAK_*
# - VITE_STRIPE_PUBLISHABLE_KEY
# - VITE_CRISP_WEBSITE_ID
# =============================================================================

# =============================================================================
# Application
# =============================================================================
VITE_APP_VERSION=1.0.0

# =============================================================================
# API Configuration
# =============================================================================
VITE_API_URL=http://localhost:3000

# =============================================================================
# Keycloak (Authentication)
# Required: YES
# These must match your Keycloak realm configuration
# =============================================================================
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=plainledger
VITE_KEYCLOAK_CLIENT_ID=plainledger-web

# =============================================================================
# Stripe (Payments)
# Required: YES (for subscription features)
# Setup: https://dashboard.stripe.com/apikeys
# Use the PUBLISHABLE key here (pk_test_... or pk_live_...)
# NEVER use the secret key in frontend code!
# =============================================================================
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# =============================================================================
# Crisp Live Chat
# Required: Recommended
# Setup: https://crisp.chat
# 1. Create account at https://crisp.chat
# 2. Add your website
# 3. Copy Website ID from Settings > Website Settings
# 
# Features included:
# - Automatic user identification (email, name, organization)
# - Page context tracking for support agents
# - Bilingual support (EN/FR)
# - Help center integration
# =============================================================================
VITE_CRISP_ENABLED=true
VITE_CRISP_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# =============================================================================
# Power BI (Embedded Reports)
# Required: NO (optional feature)
# Setup: Register an Azure AD application for Power BI embedding
# =============================================================================
VITE_POWERBI_ENABLED=false
VITE_POWERBI_CLIENT_ID=your_azure_app_client_id
VITE_POWERBI_TENANT_ID=your_azure_tenant_id
VITE_POWERBI_GROUP_ID=your_powerbi_workspace_id
VITE_POWERBI_REPORT_ID=your_default_report_id
VITE_POWERBI_EMBED_URL=

# Embedding mode: 'user' for user-owns-data, 'app' for app-owns-data
VITE_POWERBI_EMBED_MODE=app

# White Label Options (hide Power BI branding)
VITE_POWERBI_HIDE_NAV=true
VITE_POWERBI_HIDE_FILTERS=false
VITE_POWERBI_CUSTOM_THEME=

# =============================================================================
# Accounting Software Integrations
# Required: Only for integrations you want to enable
# These are CLIENT IDs only (public) - secrets are backend-only
# =============================================================================

# QuickBooks Online
# Setup: https://developer.intuit.com
VITE_QUICKBOOKS_ENABLED=true
VITE_QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
VITE_QUICKBOOKS_ENV=sandbox

# Xero
# Setup: https://developer.xero.com
VITE_XERO_ENABLED=true
VITE_XERO_CLIENT_ID=your_xero_client_id

# Sage
# Setup: https://developer.sage.com
VITE_SAGE_ENABLED=true
VITE_SAGE_CLIENT_ID=your_sage_client_id
VITE_SAGE_COUNTRY=CA

# FreshBooks
# Setup: https://www.freshbooks.com/api
VITE_FRESHBOOKS_ENABLED=true
VITE_FRESHBOOKS_CLIENT_ID=your_freshbooks_client_id

# Wave (no OAuth - uses direct API)
VITE_WAVE_ENABLED=true

# =============================================================================
# Data Lake Configuration
# =============================================================================
VITE_DATALAKE_ENABLED=true
VITE_DATALAKE_PROVIDER=s3
VITE_DATALAKE_BUCKET=plainledger-datalake
VITE_DATALAKE_REGION=ca-central-1

# =============================================================================
# Feature Flags
# =============================================================================
VITE_FEATURE_ANOMALY_DETECTION=true
VITE_FEATURE_AI=true
VITE_FEATURE_CUSTOM_REPORTS=true
VITE_FEATURE_MULTI_TENANT=false
VITE_FEATURE_AUDIT_LOGS=true
VITE_FEATURE_WEBHOOKS=true

# =============================================================================
# Branding (White Label - can be overridden per organization)
# =============================================================================
VITE_BRANDING_LOGO=
VITE_BRANDING_PRIMARY=#1a1a1a
VITE_BRANDING_ACCENT=#2563eb
VITE_BRANDING_FAVICON=/favicon.svg

# =============================================================================
# Analytics
# Required: Recommended for production
# =============================================================================

# Google Analytics 4
# Setup: https://analytics.google.com
VITE_ANALYTICS_ENABLED=true
VITE_ANALYTICS_PROVIDER=ga4
VITE_ANALYTICS_ID=G-XXXXXXXXXX

# =============================================================================
# Support & Documentation
# =============================================================================
VITE_SUPPORT_EMAIL=support@plainledger.ca
VITE_DOCS_URL=https://docs.plainledger.ca
VITE_STATUS_URL=https://status.plainledger.ca
