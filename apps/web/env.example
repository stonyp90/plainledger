# PlainLedger Web Application - Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# Application
# =============================================================================
VITE_APP_VERSION=1.0.0

# =============================================================================
# API Configuration
# =============================================================================
VITE_API_URL=http://localhost:3000

# =============================================================================
# Keycloak/Auth Configuration
# =============================================================================
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=plainledger
VITE_KEYCLOAK_CLIENT_ID=plainledger-web

# =============================================================================
# Power BI Configuration (White Label)
# =============================================================================
# Enable Power BI Integration
VITE_POWERBI_ENABLED=true

# Azure AD App Registration for Power BI
VITE_POWERBI_CLIENT_ID=
VITE_POWERBI_TENANT_ID=

# Power BI Workspace and Report
VITE_POWERBI_GROUP_ID=
VITE_POWERBI_REPORT_ID=
VITE_POWERBI_EMBED_URL=

# Embedding mode: 'user' for user-owns-data, 'app' for app-owns-data
VITE_POWERBI_EMBED_MODE=app

# White Label Options
VITE_POWERBI_HIDE_NAV=true
VITE_POWERBI_HIDE_FILTERS=false
VITE_POWERBI_CUSTOM_THEME=

# =============================================================================
# Data Source OAuth Credentials
# =============================================================================
# QuickBooks
VITE_QUICKBOOKS_ENABLED=true
VITE_QUICKBOOKS_CLIENT_ID=
VITE_QUICKBOOKS_ENV=sandbox

# Xero
VITE_XERO_ENABLED=true
VITE_XERO_CLIENT_ID=

# Sage
VITE_SAGE_ENABLED=true
VITE_SAGE_CLIENT_ID=
VITE_SAGE_COUNTRY=CA

# FreshBooks
VITE_FRESHBOOKS_ENABLED=true
VITE_FRESHBOOKS_CLIENT_ID=

# Wave
VITE_WAVE_ENABLED=true

# =============================================================================
# Data Lake Configuration
# =============================================================================
VITE_DATALAKE_ENABLED=true
VITE_DATALAKE_PROVIDER=s3
VITE_DATALAKE_BUCKET=plainledger-datalake
VITE_DATALAKE_REGION=ca-central-1

# =============================================================================
# Feature Flags
# =============================================================================
VITE_FEATURE_IBCS=true
VITE_FEATURE_AI=true
VITE_FEATURE_CUSTOM_REPORTS=true
VITE_FEATURE_MULTI_TENANT=false
VITE_FEATURE_AUDIT_LOGS=true
VITE_FEATURE_WEBHOOKS=true

# =============================================================================
# Branding (can be overridden per tenant)
# =============================================================================
VITE_BRANDING_LOGO=
VITE_BRANDING_PRIMARY=#1a1a1a
VITE_BRANDING_ACCENT=#2563eb
VITE_BRANDING_FAVICON=/favicon.svg

# =============================================================================
# Analytics
# =============================================================================
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_PROVIDER=none
VITE_ANALYTICS_ID=

# =============================================================================
# Support
# =============================================================================
VITE_SUPPORT_EMAIL=support@plainledger.ca
VITE_DOCS_URL=https://docs.plainledger.ca
VITE_STATUS_URL=https://status.plainledger.ca

# =============================================================================
# Crisp Live Chat
# Get your Website ID from https://app.crisp.chat/settings/website/
# 
# Features included:
# - Automatic user identification (email, name, organization)
# - Page context tracking for support agents
# - Bilingual support (EN/FR)
# - Help center integration
# - Quebec timezone support
# 
# To get started:
# 1. Create account at https://crisp.chat
# 2. Add your website
# 3. Copy the Website ID from Settings > Website Settings
# =============================================================================
VITE_CRISP_ENABLED=true
VITE_CRISP_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
