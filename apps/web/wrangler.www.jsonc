// Cloudflare Workers config for the www -> apex redirect (www.plainledger.ca).
// Deployed by .github/workflows/deploy-website.yml with `--domain www.plainledger.ca`
// once the plainledger.ca zone is active on Cloudflare.
{
  "name": "plainledger-www-redirect",
  "main": "worker/www-redirect.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false
}
