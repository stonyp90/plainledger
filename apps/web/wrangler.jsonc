// Cloudflare Workers config for the public website (plainledger.ca).
// See docs/CLOUDFLARE_DEPLOYMENT.md for the one-time setup and how deploys work.
//
// - Static assets (the Vite build) are served directly by Cloudflare: free, no request limit.
// - worker/index.ts runs for /api, /graphql and /health (proxy to API_ORIGIN, or a JSON 503).
// - Custom domains are attached by .github/workflows/deploy-website.yml (`--domain`) once the
//   plainledger.ca zone is active on Cloudflare, so a deploy never fails while DNS moves over.
{
  "name": "plainledger-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/graphql", "/graphql/*", "/health", "/health/*"]
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}
