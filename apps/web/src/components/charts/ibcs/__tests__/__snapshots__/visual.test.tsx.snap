exports[`IBCS Visual Snapshot Tests > VariancePin > matches snapshot for favorable variance 1`] = `
<svg
  height="200"
  width="200"
>
  <g
    aria-label="Favorable variance: +15%"
    aria-roledescription="variance indicator"
    class="variance-pin "
    data-favorable="true"
    data-variance-pct="15"
    role="graphics-symbol"
    tabindex="0"
  >
    <title>
      Favorable variance
    </title>
    <desc>
      Variance of +15% from plan
    </desc>
    <line
      stroke="rgb(var(--color-primary-600))"
      stroke-linecap="round"
      stroke-width="2"
      x1="100"
      x2="100"
      y1="50"
      y2="80"
    />
    <circle
      cx="100"
      cy="50"
      fill="rgb(var(--color-primary-600))"
      r="4"
    />
    <text
      dominant-baseline="middle"
      fill="rgb(var(--color-primary-600))"
      font-family="ui-monospace, monospace"
      font-size="9"
      font-weight="600"
      x="108"
      y="65"
    >
      +15%
    </text>
  </g>
</svg>
`;

