exports[`IBCS Visual Snapshot Tests > ScenarioBar > matches snapshot for actual bar (AC) 1`] = `
<svg
  height="200"
  width="200"
>
  <g
    aria-label="Actual: AC"
    aria-roledescription="scenario bar"
    class="scenario-bar "
    data-scenario="actual"
    role="graphics-symbol"
    style="cursor: default;"
  >
    <title>
      Actual
    </title>
    <desc>
      Actual value bar
    </desc>
    <rect
      data-scenario="actual"
      fill="#1e293b"
      height="100"
      opacity="0.9"
      rx="2"
      style="transform: scaleY(1); transform-origin: 70px 150px; transition: all 0.15s ease;"
      width="40"
      x="50"
      y="50"
    />
  </g>
</svg>
`;

exports[`IBCS Visual Snapshot Tests > ScenarioBar > matches snapshot for forecast bar (FC) 1`] = `
<svg
  height="200"
  width="200"
>
  <g
    aria-label="Forecast: FC"
    aria-roledescription="scenario bar"
    class="scenario-bar "
    data-scenario="forecast"
    role="graphics-symbol"
    style="cursor: default;"
  >
    <title>
      Forecast
    </title>
    <desc>
      Forecast value bar
    </desc>
    <rect
      data-scenario="forecast"
      fill="transparent"
      height="100"
      opacity="0.9"
      rx="2"
      stroke="#94a3b8"
      stroke-dasharray="4,2"
      stroke-width="2"
      style="transform: scaleY(1); transform-origin: 70px 150px; transition: all 0.15s ease;"
      width="40"
      x="50"
      y="50"
    />
  </g>
</svg>
`;

