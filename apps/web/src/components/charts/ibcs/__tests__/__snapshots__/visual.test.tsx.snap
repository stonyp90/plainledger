// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`IBCS Visual Snapshot Tests > IBCSHeader > matches snapshot for header with prior year 1`] = `
<div
  aria-label="Chart header"
  class="ibcs-header "
  data-testid="ibcs-header"
  role="banner"
>
  <div
    class="flex items-start justify-between gap-4 mb-2"
  >
    <div
      class="flex-1 min-w-0"
    >
      <h3
        class="font-semibold text-base truncate"
        style="color: rgb(var(--color-text));"
      >
        Revenue
      </h3>
    </div>
    <div
      class="flex items-center gap-1"
    >
      <div
        class="text-xs font-mono font-medium px-1"
        style="width: 80px; text-align: right; color: rgb(var(--color-text-muted));"
        title="Actual"
      >
        AC
      </div>
      <div
        class="text-xs font-mono font-medium px-1"
        style="width: 80px; text-align: right; color: rgb(var(--color-text-muted));"
        title="Plan"
      >
        PL
      </div>
      <div
        class="text-xs font-mono font-medium px-1"
        style="width: 80px; text-align: right; color: rgb(var(--color-text-muted));"
        title="Variance"
      >
        ΔPL
      </div>
      <div
        class="text-xs font-mono font-medium px-1"
        style="width: 60px; text-align: right; color: rgb(var(--color-text-muted));"
        title="Var %"
      >
        ΔPL%
      </div>
      <div
        class="text-xs font-mono font-medium px-1"
        style="width: 80px; text-align: right; color: rgb(var(--color-text-muted));"
        title="Prior Year"
      >
        PY
      </div>
      <div
        class="text-xs font-mono font-medium px-1"
        style="width: 60px; text-align: right; color: rgb(var(--color-text-muted));"
        title="YoY"
      >
        ΔPY%
      </div>
    </div>
  </div>
</div>
`;

