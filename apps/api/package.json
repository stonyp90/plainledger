{
  "name": "@plainledger/api",
  "version": "0.1.0",
  "description": "PlainLedger Financial Reporting API - Clean Architecture",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch --preserveWatchOutput",
    "start:debug": "nest start --debug --watch --preserveWatchOutput",
    "start:nodemon": "nodemon",
    "start:prod": "node dist/main",
    "dev": "nest start --watch --preserveWatchOutput",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --testPathIgnorePatterns=integration --forceExit",
    "test:watch": "jest --watch --testPathIgnorePatterns=integration",
    "test:cov": "jest --coverage --testPathIgnorePatterns=integration --forceExit",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:integration": "jest --testPathPattern=integration",
    "test:integration:datalake": "jest --testPathPattern=datalake-integration",
    "test:integration:quickbooks": "jest --testPathPattern=quickbooks-integration",
    "test:contract": "jest --testPathPattern=contract",
    "swagger:export": "node -e \"require('./dist/main').then(() => process.exit(0))\""
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@aws-sdk/client-athena": "^3.750.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.985.0",
    "@aws-sdk/client-glue": "^3.750.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/client-sagemaker": "^3.985.0",
    "@aws-sdk/client-sagemaker-runtime": "^3.750.0",
    "@aws-sdk/client-ses": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@azure/identity": "^4.6.0",
    "@hubspot/api-client": "^13.4.0",
    "@keycloak/keycloak-admin-client": "^26.1.0",
    "@nestjs/apollo": "^13.2.4",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/graphql": "^13.2.4",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@types/compression": "^1.8.1",
    "@types/pg": "^8.16.0",
    "axios": "^1.7.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "graphql": "^16.12.0",
    "graphql-scalars": "^1.25.0",
    "graphql-subscriptions": "^3.0.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.6.0",
    "keycloak-connect": "^26.1.0",
    "minio": "^8.0.5",
    "mongodb": "^6.14.0",
    "nest-keycloak-connect": "^1.10.0",
    "openai": "^4.80.0",
    "papaparse": "^5.5.3",
    "pg": "^8.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.20",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.0",
    "@types/node-fetch": "^2.6.13",
    "@types/papaparse": "^5.5.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^17.3.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@domain/(.*)$": "<rootDir>/domain/$1",
      "^@application/(.*)$": "<rootDir>/application/$1",
      "^@infrastructure/(.*)$": "<rootDir>/infrastructure/$1",
      "^@__fixtures__/(.*)$": "<rootDir>/__fixtures__/$1"
    },
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      },
      "./infrastructure/cache/": {
        "branches": 85,
        "functions": 85,
        "lines": 85,
        "statements": 85
      },
      "./infrastructure/etl/": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      },
      "./infrastructure/ai/": {
        "branches": 75,
        "functions": 75,
        "lines": 75,
        "statements": 75
      }
    }
  }
}
