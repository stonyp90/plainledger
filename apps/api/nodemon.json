{
  "watch": ["src"],
  "ext": "ts,json,graphql,html",
  "ignore": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "node_modules",
    "dist"
  ],
  "exec": "ts-node -r tsconfig-paths/register src/main.ts",
  "delay": 100,
  "verbose": false,
  "legacyWatch": false,
  "env": {
    "NODE_ENV": "development"
  }
}
