# =============================================================================
# PlainLedger API - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# 
# REQUIRED KEYS FOR PRODUCTION:
# - DATABASE_* (PostgreSQL)
# - KEYCLOAK_* (Authentication)
# - JWT_SECRET, ENCRYPTION_KEY (Security)
# - STRIPE_* (Payments)
# - NOVU_* (Notifications)
# - AWS_* (S3 Storage)
# =============================================================================

# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_URL=http://localhost:5173

# =============================================================================
# Database (PostgreSQL)
# Required: YES
# Setup: Create a PostgreSQL database for PlainLedger
# =============================================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=plainledger
DATABASE_USER=plainledger
DATABASE_PASSWORD=your_secure_database_password

# Or use a connection string (overrides individual settings above)
# DATABASE_URL=postgresql://user:password@host:5432/database

# =============================================================================
# Redis (Caching & Sessions)
# Required: Recommended for production
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# Keycloak (Authentication)
# Required: YES
# Setup: https://www.keycloak.org/getting-started
# 1. Deploy Keycloak (Docker or managed service)
# 2. Create a realm named 'plainledger'
# 3. Create a confidential client for the API
# 4. Copy the client secret here
# =============================================================================
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=plainledger
KEYCLOAK_CLIENT_ID=plainledger-api
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret

# =============================================================================
# Security
# Required: YES (for production)
# Generate with: openssl rand -hex 32
# =============================================================================
JWT_SECRET=your_32_char_jwt_secret_key_here
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# AES-256 encryption key for secrets (32 characters)
ENCRYPTION_KEY=your_32_character_encryption_key

# Webhook signature verification
WEBHOOK_SECRET=your_webhook_secret_key

# =============================================================================
# Stripe (Payments & Subscriptions)
# Required: YES (for paid features)
# Setup: https://dashboard.stripe.com/apikeys
# 1. Create a Stripe account
# 2. Get your API keys from Dashboard > Developers > API keys
# 3. Set up webhook endpoint: /api/v1/webhooks/stripe
# 4. Get webhook secret from Developers > Webhooks
# =============================================================================
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Stripe Price IDs (create products in Stripe Dashboard)
STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly_id
STRIPE_PRICE_STARTER_YEARLY=price_starter_yearly_id
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_professional_monthly_id
STRIPE_PRICE_PROFESSIONAL_YEARLY=price_professional_yearly_id
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_enterprise_monthly_id
STRIPE_PRICE_ENTERPRISE_YEARLY=price_enterprise_yearly_id

# =============================================================================
# Novu (Notifications)
# Required: YES (for transactional emails)
# Setup: https://novu.co
# 1. Create a Novu account
# 2. Get API key from Settings > API Keys
# 3. Get App ID from Settings > General
# 4. Create notification workflows matching IDs in novu.service.ts
# =============================================================================
NOVU_API_KEY=your_novu_api_key
NOVU_APP_ID=your_novu_app_id

# =============================================================================
# Power BI (Embedded Reports)
# Required: NO (optional feature)
# Setup: https://docs.microsoft.com/en-us/power-bi/developer/embedded/
# 1. Register an Azure AD application
# 2. Grant Power BI Service permissions
# 3. Create a Power BI workspace and reports
# =============================================================================
POWERBI_TENANT_ID=your_azure_tenant_id
POWERBI_CLIENT_ID=your_azure_app_client_id
POWERBI_CLIENT_SECRET=your_azure_app_client_secret
POWERBI_DEFAULT_GROUP_ID=your_powerbi_workspace_id

# =============================================================================
# Accounting Software OAuth (Data Connections)
# Required: Only for enabled integrations
# =============================================================================

# QuickBooks Online
# Setup: https://developer.intuit.com/app/developer/qbo/docs/get-started
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/v1/datasources/oauth/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox
# Options: "sandbox" (default, safe for testing) or "production" (real QuickBooks data)
# WARNING: Setting to "production" affects ALL users and connections!

# Xero
# Setup: https://developer.xero.com/documentation/getting-started-guide/
XERO_CLIENT_ID=your_xero_client_id
XERO_CLIENT_SECRET=your_xero_client_secret
XERO_REDIRECT_URI=http://localhost:3000/api/v1/datasources/oauth/xero/callback

# Sage
# Setup: https://developer.sage.com/accounting/
SAGE_CLIENT_ID=your_sage_client_id
SAGE_CLIENT_SECRET=your_sage_client_secret
SAGE_REDIRECT_URI=http://localhost:3000/api/v1/datasources/oauth/sage/callback

# FreshBooks
# Setup: https://www.freshbooks.com/api/
FRESHBOOKS_CLIENT_ID=your_freshbooks_client_id
FRESHBOOKS_CLIENT_SECRET=your_freshbooks_client_secret
FRESHBOOKS_REDIRECT_URI=http://localhost:3000/api/v1/datasources/oauth/freshbooks/callback

# =============================================================================
# AWS (S3 Data Lake)
# Required: YES (for file storage)
# Setup: Create an S3 bucket and IAM user with S3 access
# =============================================================================
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=plainledger-datalake

# For local development with MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# =============================================================================
# AI / LLM (Natural Language Queries)
# Required: NO (optional feature)
# At least one is required if AI features are enabled
# =============================================================================
OPENAI_API_KEY=sk-your_openai_api_key
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=debug
LOG_FORMAT=json
