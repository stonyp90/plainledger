# Copy to the VM only: /opt/plainledger/shared/runtime.env, mode 0600.
# This is a data file, NOT a shell script. No export, quotes or variable expansion.
# Every blank required value is rejected before deployment. Never commit real secrets.
APP_DOMAIN=plainledger.ca
AUTH_DOMAIN=auth.plainledger.ca
ADMIN_DOMAIN=admin.plainledger.ca
STORAGE_DOMAIN=files.plainledger.ca
TLS_EMAIL=

# Digests resolved from official registry manifests on 2026-10-19.
# Pinning is reproducibility, not a vulnerability or production certification.
CADDY_IMAGE=caddy:2-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f
APP_DB_IMAGE=pgvector/pgvector:pg16@sha256:7b822b0aac60967beb1ea5e576b8602c94c300a157d187f385ae3e0da199b90a
KEYCLOAK_DB_IMAGE=postgres:16-alpine@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea
REDIS_IMAGE=redis:7-alpine@sha256:858f009f9709ce576febc734aa78b8f6d624b82571f9ddb6bda4377c833b3499
MONGODB_IMAGE=mongo:7.0@sha256:c53852c00c23ca9f23fc39690350ffa9a80e3642fe8f96879726d8da0abe80a7
# Official MinIO/mc manifest requests returned 401 during this audit.
# Supply accessible, reviewed official images pinned with @sha256:<64 hex digits>.
MINIO_IMAGE=
MINIO_CLIENT_IMAGE=

APP_DB_NAME=plainledger
APP_DB_USER=plainledger
APP_DB_PASSWORD=
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET=
REDIS_PASSWORD=
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_APP_DB=plainledger_analytics
MONGO_APP_USER=plainledger_app
MONGO_APP_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=
UNSUBSCRIBE_SECRET=

S3_REGION=ca-montreal-1
S3_BUCKET_BRONZE=plainledger-bronze
S3_BUCKET_SILVER=plainledger-silver
S3_BUCKET_GOLD=plainledger-gold
S3_BUCKET_UPLOADS=plainledger-public-assets
S3_BUCKET_DOCUMENT_SHARE=plainledger-document-share

# Keycloak verification/reset mail. Configure an authorized SMTP service.
# API transactional mail still uses an AWS SES adapter: see README limitations.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional external provider configuration. Empty values do not imply verification.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
