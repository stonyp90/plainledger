{
  "name": "plainledger",
  "version": "1.0.0",
  "description": "PlainLedger - Financial Reporting SaaS Platform",
  "scripts": {
    "install:all": "cd apps/api && npm install && cd ../web && npm install && cd ../..",
    "dev": "concurrently -n api,web -c cyan,magenta --kill-others-on-fail \"npm run dev:api\" \"npm run dev:web\"",
    "dev:all": "./local-dev/dev.sh",
    "dev:infra": "docker-compose up -d keycloak-db app-db redis keycloak localstack minio",
    "dev:api": "cd apps/api && npm run start:dev",
    "dev:web": "cd apps/web && npm run dev",
    "dev:stop": "pkill -f 'nest start' 2>/dev/null; pkill -f 'vite' 2>/dev/null; echo 'Stopped'",
    "dev:logs": "tail -f /tmp/plainledger-logs/*.log",
    "dev:clean": "rm -rf apps/api/dist apps/web/dist apps/api/node_modules/.cache apps/web/node_modules/.vite",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:unauthenticated": "playwright test --project=unauthenticated",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:containers": "USE_TESTCONTAINERS=true playwright test",
    "test:e2e:api": "playwright test api-contract.spec.ts",
    "test:e2e:integration": "playwright test integration-with-fixtures.spec.ts",
    "check:class-sizes": "./scripts/check-class-sizes.sh",
    "tokens": "node design-system/build-tokens.mjs",
    "tokens:check": "node design-system/build-tokens.mjs --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@keycloak/keycloak-admin-client": "^26.5.5",
    "@playwright/test": "^1.50.1",
    "@testcontainers/postgresql": "^11.0.0",
    "@testcontainers/redis": "^11.0.0",
    "@types/pg": "^8.16.0",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "pg": "^8.14.0",
    "testcontainers": "^11.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0"
  },
  "lint-staged": {
    "apps/api/**/*.{ts,tsx}": [
      "apps/api/node_modules/.bin/eslint --fix --config apps/api/eslint.config.mjs",
      "apps/api/node_modules/.bin/prettier --write"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "apps/web/node_modules/.bin/eslint --fix --config apps/web/eslint.config.js",
      "apps/api/node_modules/.bin/prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "apps/api/node_modules/.bin/prettier --write"
    ]
  }
}
