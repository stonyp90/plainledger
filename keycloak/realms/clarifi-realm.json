{
  "id": "clarifi",
  "realm": "clarifi",
  "displayName": "Clarifi",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>Clarifi</span></div>",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "verifyEmail": false,
  "loginTheme": "clarifi",
  "accountTheme": "keycloak.v2",
  "emailTheme": "clarifi",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "fr"],
  "defaultLocale": "fr",
  "smtpServer": {
    "host": "mailhog",
    "port": "1025",
    "from": "noreply@clarifi.io",
    "fromDisplayName": "Clarifi",
    "replyTo": "support@clarifi.io",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "passwordPolicy": "length(8) and upperCase(1) and lowerCase(1) and digits(1)",
  "clients": [
    {
      "clientId": "clarifi-web",
      "name": "Clarifi Web Application",
      "description": "Frontend React application for Clarifi financial reporting",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:5173/*",
        "https://app.clarifi.io/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000",
        "http://127.0.0.1:5173",
        "https://app.clarifi.io",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##https://app.clarifi.io/*"
      }
    },
    {
      "clientId": "clarifi-api",
      "name": "Clarifi API Backend",
      "description": "NestJS API backend service",
      "enabled": true,
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "secret": "change-me-in-production",
      "redirectUris": [
        "http://localhost:3000/*",
        "https://api.clarifi.io/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "https://api.clarifi.io",
        "+"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator with full access"
      },
      {
        "name": "accountant",
        "description": "Accountant with access to financial reports"
      },
      {
        "name": "viewer",
        "description": "Read-only access to reports"
      },
      {
        "name": "owner",
        "description": "Organization owner with billing access"
      }
    ]
  },
  "defaultRoles": ["viewer"],
  "groups": [
    {
      "name": "Administrators",
      "realmRoles": ["admin"]
    },
    {
      "name": "Accountants",
      "realmRoles": ["accountant"]
    },
    {
      "name": "Viewers",
      "realmRoles": ["viewer"]
    }
  ],
  "users": [
    {
      "username": "admin@clarifi.io",
      "email": "admin@clarifi.io",
      "firstName": "Admin",
      "lastName": "Clarifi",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin123!",
          "temporary": false
        }
      ],
      "realmRoles": ["admin", "owner"],
      "groups": ["Administrators"],
      "attributes": {
        "organization": ["clarifi-demo"],
        "locale": ["fr"]
      }
    },
    {
      "username": "comptable@clarifi.io",
      "email": "comptable@clarifi.io",
      "firstName": "Marie",
      "lastName": "Tremblay",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Comptable123!",
          "temporary": false
        }
      ],
      "realmRoles": ["accountant"],
      "groups": ["Accountants"],
      "attributes": {
        "organization": ["clarifi-demo"],
        "locale": ["fr"]
      }
    },
    {
      "username": "demo@clarifi.io",
      "email": "demo@clarifi.io",
      "firstName": "Demo",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Demo123!",
          "temporary": false
        }
      ],
      "realmRoles": ["viewer"],
      "groups": ["Viewers"],
      "attributes": {
        "organization": ["clarifi-demo"],
        "locale": ["en"]
      }
    }
  ],
  "clientScopes": [
    {
      "name": "organization",
      "description": "Organization scope for multi-tenancy",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "organization-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "organization",
            "claim.name": "organization",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
